    "render:pdf": "node src/render.mjs",
    "postinstall:browser": "playwright install chromium"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdf-lib/standard-fonts": "^1.0.0",
    "@pdf-lib/upng": "^1.0.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.1"
  }
}
